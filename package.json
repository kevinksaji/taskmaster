{
  "name": "taskmaster-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Telegram bot for managing Scrum-style epics and tasks through Telegram.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "webhook:delete": "tsx scripts/delete-webhook.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.1",
    "@vercel/node": "^5.1.12",
    "prisma": "^6.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
